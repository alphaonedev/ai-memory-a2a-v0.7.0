# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.pytest_cache/
.venv/
venv/

# Rust (orchestrator may stage a binary here)
target/
Cargo.lock

# Terraform
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
.terraform.lock.hcl
crash.log
crash.*.log

# Secrets / local env
.env
.env.local
*.pem
*.key
