# macOS
.DS_Store
.AppleDouble
.LSOverride

# Editor
.idea/
.vscode/
*.swp
*~

# mkdocs build output
site/

# Per-run evidence is checked-in selectively by the campaign workflow;
# everything else under runs/ is gitignored.
runs/*
!runs/README.md
!runs/.gitkeep
