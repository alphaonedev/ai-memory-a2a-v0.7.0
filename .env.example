#
# Copy this file to `.env` (gitignored) and fill in real values.
# All values listed here are required for a full Round-1 campaign;
# orchestrator-driven runs source these directly into the GitHub
# Actions environment via repo secrets of the same names.

# ---- DigitalOcean ----
DIGITALOCEAN_TOKEN=                     # DO API token with droplet:write, vpc:write, firewall:write
DIGITALOCEAN_SSH_KEY_FINGERPRINT=bf:0b:e1:92:6f:ea:0d:1d:e4:96:ee:ac:71:73:ed:4e
DIGITALOCEAN_SSH_KEY_ID=55757076        # DO key id for the registered key (name "ai-memory-ai2ai-gate")
DIGITALOCEAN_SSH_PRIVATE_KEY_PATH=~/.ssh/id_ed25519

# ---- xAI / Grok 4.2 ----
XAI_API_KEY=                            # xAI API key, scope "chat:complete reasoning"
XAI_MODEL=grok-4.20-0309-reasoning      # SKU under test for v0.7.0 A2A campaign
XAI_BASE_URL=https://api.x.ai/v1        # Override only if proxying

# ---- ai-memory binary under test ----
AI_MEMORY_GIT_REF=v0.7.0                # Tag, branch, or SHA on alphaonedev/ai-memory-mcp (>= dfb184f)
AI_MEMORY_BINARY_PATH=/Users/fate/v07/v07-fixes/target/release/ai-memory
                                        # Pre-built binary the orchestrator scp's to both droplets

# ---- Agent runtimes ----
OPENCLAW_REPO=https://github.com/openclawai/openclaw
OPENCLAW_REF=main
HERMES_REPO=https://github.com/hermesframework/hermes
HERMES_REF=main

# ---- Topology ----
# Both droplets get s-4vcpu-16gb-amd in nyc3, joined to one campaign-scoped VPC.
# The harness drives both via Grok 4.2; ai-memory talks A2A over mTLS on 19077
# inside the VPC.
A2A_PORT=19077
AI_MEMORY_AUDIT_DIR=/var/log/ai-memory/audit/

# ---- Postgres + Apache AGE (S70-S76) ----
# v0.7.0-alpha postgres is migration-target + SAL-trait-only — NOT the live
# storage backend. `ai-memory serve --store-url postgres://...` is deferred
# to v0.7.1. Used by S70 (migration round-trip), S71 (AGE/CTE equivalence),
# S72 (A2A KG via pg+AGE), S73 (sal_contract.rs), S74 (UnsupportedCapability),
# S75 (schema parity snapshot), S76 (AGE perf gate).
POSTGRES_HOST=10.20.0.4                 # private VPC IP for postgres-node
POSTGRES_PORT=5432
POSTGRES_DB=aimemory
POSTGRES_USER=aimemory                  # superuser; the disposable test
                                        # databases (aimemory_s70, aimemory_kgtest,
                                        # aimemory_s72, aimemory_saltest,
                                        # aimemory_s74, aimemory_perf) require
                                        # CREATEDB which the user already has.
POSTGRES_PASSWORD_PATH=/tmp/v07-a2a-pg-password.txt
                                        # mode 600 on the orchestrator host.
                                        # Harness.postgres_url() reads this and
                                        # url-encodes safely.
POSTGRES_AGE_VERSION=1.5.0              # Apache AGE on postgres-node
